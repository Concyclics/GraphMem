# Optional token for a Memory service exposed beyond localhost.
# GRAPHMEM_API_KEY=replace-with-a-service-secret

# Exact local tokenizer for the configured chat model.
# GRAPHMEM_TOKENIZER_PATH=/models/Qwen3-30B-A3B-Instruct-2507-FP8/tokenizer.json

# Optional model credentials; reference this name in config/memory-service.json.
# GRAPHMEM_MODEL_API_KEY=replace-with-your-model-key
# HF_HOME=/path/to/huggingface
