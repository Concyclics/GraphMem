{
  "schema_version": "graphmem-v5",
  "profile": "b5",
  "random_seed": 42,
  "models": {
    "llm_model": "Qwen/Qwen3-30B-A3B-Instruct-2507-FP8",
    "llm_base_url": "http://127.0.0.1:8002/v1",
    "embedding_model": "Qwen/Qwen3-Embedding-0.6B",
    "embedding_base_url": "http://127.0.0.1:8001/v1",
    "thinking_enabled": false,
    "max_concurrency": 128,
    "semantic_batch_scenes": 2,
    "semantic_batch_input_tokens": 12000,
    "semantic_scene_input_tokens": 12000,
    "semantic_turn_input_chars": 2500,
    "semantic_batch_output_tokens": 1024,
    "semantic_average_tokens_per_memory": 220000,
    "semantic_max_facts_per_scene": 4,
    "semantic_summary_tokens": 48,
    "semantic_repair_output_tokens": 256,
    "semantic_constrained_json": false,
    "semantic_individual_repair": false,
    "semantic_extraction_mode": "strict_pair",
    "semantic_max_retries": 1,
    "semantic_retry_output_tokens": 1024,
    "semantic_compile_summary": true
  },
  "scenes": {
    "min_turns": 2,
    "max_turns": 4,
    "topic_similarity_threshold": 0.55,
    "max_events_per_scene": 3,
    "coreference_margin": 0.08,
    "refine_batch_size": 24,
    "llm_semantic_extraction": true,
    "llm_hierarchy_compression": false
  },
  "storage": {
    "runtime_mode": "sqlite_snapshot",
    "sqlite_path": "artifacts/v5_4/graphmem.sqlite",
    "neo4j_enabled": false,
    "neo4j_uri": "bolt://127.0.0.1:7687",
    "neo4j_batch_nodes": 1000,
    "neo4j_batch_edges": 2000
  },
  "coarsen": {"fanout": 8, "max_levels": 3, "summary_tokens": 320, "cross_session_merge": false},
  "edges": {
    "embedding_k": 8,
    "max_candidates_per_node": 24,
    "max_degree_per_relation": 12,
    "low_threshold": 0.45,
    "high_threshold": 0.78,
    "refine_mode": "none",
    "refine_batch_size": 24,
    "max_refine_calls_per_1000_turns": 0,
    "graph_variant": "g5",
    "temporal_normalization": true,
    "cross_session_portals": false,
    "predicate_embedding_threshold": 0.92,
    "portal_degree_cap": 2,
    "relation_degree_caps": {
      "refines_to": 64,
      "scene_contains": 32,
      "has_fact": 128,
      "participates_in": 32,
      "at_time": 8,
      "state_next": 8,
      "temporal_before": 8,
      "collection_co_member": 32,
      "portal": 2
    }
  },
  "query_budget": {
    "max_hops": 2,
    "max_iterations": 4,
    "max_visited_nodes": 96,
    "max_visited_edges": 192,
    "max_frontier": 32,
    "max_evidence_turns": 16,
    "max_evidence_tokens": 5000,
    "max_llm_reranks": 0
  }
}
