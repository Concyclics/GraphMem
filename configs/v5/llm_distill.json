{
  "schema_version": "graphmem-v5",
  "profile": "b5",
  "random_seed": 42,
  "models": {
    "llm_model": "Qwen/Qwen3-30B-A3B-Instruct-2507-FP8",
    "llm_base_url": "http://127.0.0.1:8002/v1",
    "embedding_model": "Qwen/Qwen3-Embedding-0.6B",
    "embedding_base_url": "http://127.0.0.1:8001/v1",
    "thinking_enabled": false,
    "max_concurrency": 128,
    "refine_input_tokens_per_endpoint": 96,
    "refine_output_tokens": 256,
    "bridge_refine_output_tokens": 512,
    "semantic_batch_scenes": 4,
    "semantic_batch_input_tokens": 12000,
    "semantic_scene_input_tokens": 16000,
    "semantic_batch_output_tokens": 4096,
    "semantic_average_tokens_per_memory": 180000
  },
  "scenes": {
    "min_turns": 2,
    "max_turns": 8,
    "topic_similarity_threshold": 0.55,
    "max_events_per_scene": 3,
    "coreference_margin": 0.08,
    "refine_batch_size": 24,
    "llm_semantic_extraction": true,
    "llm_hierarchy_compression": true
  },
  "storage": {
    "runtime_mode": "sqlite_snapshot",
    "sqlite_path": "artifacts/v5_1/graphmem.sqlite",
    "neo4j_enabled": false,
    "neo4j_uri": "bolt://127.0.0.1:7687",
    "neo4j_batch_nodes": 1000,
    "neo4j_batch_edges": 2000
  },
  "coarsen": {"fanout": 8, "max_levels": 3, "summary_tokens": 320, "cross_session_merge": true},
  "edges": {
    "embedding_k": 8,
    "max_candidates_per_node": 24,
    "max_degree_per_relation": 12,
    "low_threshold": 0.45,
    "high_threshold": 0.78,
    "refine_mode": "none",
    "refine_batch_size": 24,
    "max_refine_calls_per_1000_turns": 0,
    "relation_degree_caps": {
      "same_event": 4, "same_activity": 8, "state_next": 4,
      "state_transition": 4, "temporal_before": 8, "shared_entity": 32,
      "shared_value": 32, "collection_co_member": 128
      ,"has_fact": 64, "fact_value": 64, "coreference": 32
    }
  },
  "query_budget": {
    "max_hops": 2, "max_iterations": 4, "max_visited_nodes": 96,
    "max_visited_edges": 192, "max_frontier": 32,
    "max_evidence_turns": 16, "max_evidence_tokens": 5000, "max_llm_reranks": 0
  }
}
